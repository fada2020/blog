---
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getGoogleAdsenseClient, type AdPlacement } from "../lib/ads";
import { BASE_PATH } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  adPlacement?: AdPlacement;
}

const {
  title,
  description,
  image,
  imageAlt,
  article = false,
} = Astro.props;
const path = Astro.url.pathname.startsWith(BASE_PATH)
  ? Astro.url.pathname.slice(BASE_PATH.length) || "/"
  : Astro.url.pathname;
const googleAdsenseClient = getGoogleAdsenseClient(import.meta.env);
const googleAdsenseScript =
  googleAdsenseClient
    ? `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(
        googleAdsenseClient,
      )}`
    : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={title}
      description={description}
      path={path}
      image={image}
      imageAlt={imageAlt}
      article={article}
    />
    {
      googleAdsenseScript && (
        <script
          is:inline
          async
          src={googleAdsenseScript}
          crossorigin="anonymous"
        ></script>
      )
    }
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme =
        savedTheme === "light" || savedTheme === "dark"
          ? savedTheme
          : prefersDark
            ? "dark"
            : "light";
    </script>
  </head>
  <body>
    <SiteHeader />
    <main class="site-main site-shell">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
