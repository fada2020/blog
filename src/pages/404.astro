---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/site";
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지가 없거나 이동했습니다."
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404</p>
    <h1 id="not-found-title">페이지를 찾을 수 없습니다</h1>
    <p>주소를 다시 확인하거나 다른 글을 찾아보세요.</p>
    <nav aria-label="오류 페이지 탐색">
      <a href={withBase("/")}>홈으로 이동</a>
      <a href={withBase("/search/")}>글 검색</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    width: min(100%, 640px);
    padding-block: 56px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-size: 14px;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: 42px;
    line-height: 1.3;
  }

  p {
    color: var(--color-muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 28px;
  }

  a {
    color: var(--color-link);
    font-weight: 700;
  }
</style>
