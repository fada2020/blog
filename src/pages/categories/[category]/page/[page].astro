---
import Pagination from "../../../../components/Pagination.astro";
import PostList from "../../../../components/PostList.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getAdditionalPageNumbers,
  paginateItems,
} from "../../../../lib/pagination";
import { getPublishedPosts } from "../../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map(({ data }) => data.category))];

  return categories.flatMap((category) => {
    const categoryPosts = posts.filter(({ data }) => data.category === category);

    return getAdditionalPageNumbers(categoryPosts.length).map((page) => ({
      params: { category, page: String(page) },
      props: { category, page, posts: categoryPosts },
    }));
  });
}

const { category, page: currentPage, posts } = Astro.props;
const page = paginateItems(posts, currentPage);
---

<BaseLayout
  title={`${category} 글 ${page.currentPage}페이지`}
  description={`${category} 카테고리의 공개 기술 글 ${page.currentPage}페이지입니다.`}
>
  <header class="archive-header">
    <p>카테고리</p>
    <h1>{category} 글</h1>
    <span>{page.totalItems}개의 글 · {page.currentPage}/{page.totalPages}페이지</span>
  </header>
  <PostList posts={page.items} />
  <Pagination
    basePath={`/categories/${encodeURIComponent(category)}/`}
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    label={`${category} 글 페이지 이동`}
  />
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 36px;
  }

  .archive-header p,
  .archive-header span {
    color: var(--color-muted);
    font-size: 14px;
  }

  .archive-header p {
    margin: 0 0 6px;
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 40px;
    letter-spacing: 0;
  }
</style>
