---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Field Notes"
  description="현장에서 배운 기술을 차분하게 기록하는 기술 블로그입니다."
>
  <section class="reading-width" aria-labelledby="page-title">
    <p class="eyebrow">기술 블로그</p>
    <h1 id="page-title">현장에서 배운 기술을<br />차분하게 기록합니다.</h1>
    <p class="intro">
      Spring Boot 개발자의 시선으로 프런트엔드, 인프라, 관측 가능성을 직접
      부딪히며 정리합니다.
    </p>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: 8px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .intro {
    max-width: 700px;
    margin: 18px 0 0;
    color: var(--color-muted);
    font-size: 17px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 34px;
    }

    .intro {
      font-size: 16px;
    }
  }
</style>
