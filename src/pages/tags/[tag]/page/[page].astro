---
import Pagination from "../../../../components/Pagination.astro";
import PostList from "../../../../components/PostList.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getAdditionalPageNumbers,
  paginateItems,
} from "../../../../lib/pagination";
import { getPublishedPosts } from "../../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap(({ data }) => data.tags))];

  return tags.flatMap((tag) => {
    const taggedPosts = posts.filter(({ data }) => data.tags.includes(tag));

    return getAdditionalPageNumbers(taggedPosts.length).map((page) => ({
      params: { page: String(page), tag },
      props: { page, posts: taggedPosts, tag },
    }));
  });
}

const { page: currentPage, posts, tag } = Astro.props;
const page = paginateItems(posts, currentPage);
---

<BaseLayout title={`#${tag} ${page.currentPage}페이지`} description={`${tag} 태그의 공개 기술 글 ${page.currentPage}페이지입니다.`}>
  <header class="archive-header">
    <p>태그</p>
    <h1>#{tag}</h1>
    <span>{page.totalItems}개의 글 · {page.currentPage}/{page.totalPages}페이지</span>
  </header>
  <PostList posts={page.items} />
  <Pagination
    basePath={`/tags/${encodeURIComponent(tag)}/`}
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    label={`#${tag} 페이지 이동`}
  />
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 36px;
  }

  .archive-header p,
  .archive-header span {
    color: var(--color-muted);
    font-size: 14px;
  }

  .archive-header p {
    margin: 0 0 6px;
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 40px;
    letter-spacing: 0;
  }
</style>
