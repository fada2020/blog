---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";
import { withBase } from "../../lib/site";

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap(({ data }) => data.tags))]
  .sort()
  .map((tag) => ({
    tag,
    count: posts.filter(({ data }) => data.tags.includes(tag)).length,
  }));
---

<BaseLayout title="태그" description="Field Notes의 기술 글 태그입니다.">
  <header class="archive-header">
    <h1>태그</h1>
    <p>구체적인 기술 키워드로 기록을 찾아보세요.</p>
  </header>
  <ul class="tag-cloud">
    {
      tags.map(({ tag, count }) => (
        <li>
          <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
            <span>#{tag}</span>
            <small>{count}</small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 32px;
  }

  h1 {
    margin: 0;
    font-size: 40px;
  }

  .archive-header p {
    color: var(--color-muted);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-cloud a {
    display: flex;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    text-decoration: none;
  }

  small {
    color: var(--color-muted);
  }
</style>
