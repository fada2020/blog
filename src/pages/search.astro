---
import SearchPanel from "../components/SearchPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="검색"
  description="Field Notes의 공개 기술 글을 제목, 설명, 카테고리와 태그로 검색합니다."
>
  <header class="page-header reading-width">
    <p>Search</p>
    <h1>글 검색</h1>
    <span>필요한 기술 기록을 빠르게 찾아보세요.</span>
  </header>
  <SearchPanel />
</BaseLayout>

<style>
  .page-header p {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(32px, 6vw, 48px);
    line-height: 1.15;
  }

  .page-header span {
    display: block;
    margin-top: 12px;
    color: var(--color-muted);
  }
</style>
