---
import type { PostKind } from "../../../../content.config";
import Pagination from "../../../../components/Pagination.astro";
import PostList from "../../../../components/PostList.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getAdditionalPageNumbers,
  paginateItems,
} from "../../../../lib/pagination";
import { kindLabels } from "../../../../lib/post-kind";
import { getPublishedPosts } from "../../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const kinds = [...new Set(posts.map(({ data }) => data.kind))];

  return kinds.flatMap((kind) => {
    const kindPosts = posts.filter(({ data }) => data.kind === kind);

    return getAdditionalPageNumbers(kindPosts.length).map((page) => ({
      params: { kind, page: String(page) },
      props: { kind, page, posts: kindPosts },
    }));
  });
}

const { kind, page: currentPage, posts } = Astro.props as {
  kind: PostKind;
  page: number;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
};
const label = kindLabels[kind];
const page = paginateItems(posts, currentPage);
---

<BaseLayout
  title={`${label} 글 ${page.currentPage}페이지`}
  description={`${label} 유형의 공개 기술 글 ${page.currentPage}페이지입니다.`}
>
  <header class="archive-header">
    <p>글 유형</p>
    <h1>{label} 글</h1>
    <span>{page.totalItems}개의 글 · {page.currentPage}/{page.totalPages}페이지</span>
  </header>
  <PostList posts={page.items} />
  <Pagination
    basePath={`/kinds/${kind}/`}
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    label={`${label} 글 페이지 이동`}
  />
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 36px;
  }

  .archive-header p,
  .archive-header span {
    color: var(--color-muted);
    font-size: 14px;
  }

  .archive-header p {
    margin: 0 0 6px;
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 40px;
    letter-spacing: 0;
  }
</style>
