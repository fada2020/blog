---
import type { PostKind } from "../../content.config";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { kindLabels } from "../../lib/post-kind";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const kinds = [...new Set(posts.map(({ data }) => data.kind))];

  return kinds.map((kind) => ({
    params: { kind },
    props: {
      kind,
      posts: posts.filter(({ data }) => data.kind === kind),
    },
  }));
}

const { kind, posts } = Astro.props as {
  kind: PostKind;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
};
const label = kindLabels[kind];
---

<BaseLayout
  title={`${label} 글`}
  description={`${label} 유형의 공개 기술 글입니다.`}
>
  <header class="archive-header">
    <p>글 유형</p>
    <h1>{label} 글</h1>
    <span>{posts.length}개의 글</span>
  </header>
  <PostList posts={posts} />
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 36px;
  }

  .archive-header p,
  .archive-header span {
    color: var(--color-muted);
    font-size: 14px;
  }

  .archive-header p {
    margin: 0 0 6px;
    color: var(--color-accent);
    font-weight: 700;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 40px;
    letter-spacing: 0;
  }
</style>
