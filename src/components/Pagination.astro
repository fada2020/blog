---
import { withBase } from "../lib/site";

interface Props {
  basePath: string;
  currentPage: number;
  label?: string;
  totalPages: number;
}

const { basePath, currentPage, label = "페이지 이동", totalPages } = Astro.props;
const normalizedBasePath = basePath.endsWith("/") ? basePath : `${basePath}/`;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const hrefFor = (page: number) =>
  withBase(page === 1 ? normalizedBasePath : `${normalizedBasePath}page/${page}/`);
const previousPage = currentPage > 1 ? currentPage - 1 : undefined;
const nextPage = currentPage < totalPages ? currentPage + 1 : undefined;
---

{
  totalPages > 1 ? (
    <nav class="pagination" aria-label={label}>
      {previousPage ? (
        <a class="page-link page-step" href={hrefFor(previousPage)} rel="prev">
          이전
        </a>
      ) : (
        <span class="page-link page-step is-disabled" aria-disabled="true">
          이전
        </span>
      )}
      <ol class="page-list">
        {pageNumbers.map((page) => (
          <li>
            {page === currentPage ? (
              <span class="page-link is-current" aria-current="page">
                {page}
              </span>
            ) : (
              <a class="page-link" href={hrefFor(page)}>
                {page}
              </a>
            )}
          </li>
        ))}
      </ol>
      {nextPage ? (
        <a class="page-link page-step" href={hrefFor(nextPage)} rel="next">
          다음
        </a>
      ) : (
        <span class="page-link page-step is-disabled" aria-disabled="true">
          다음
        </span>
      )}
    </nav>
  ) : null
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
  }

  .page-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-link {
    display: inline-flex;
    min-width: 40px;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .page-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .page-step {
    min-width: 64px;
  }

  .is-current {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .is-disabled {
    color: var(--color-muted);
    opacity: 0.45;
  }

  .is-disabled:hover {
    border-color: var(--color-border);
    color: var(--color-muted);
  }

  .is-current:hover {
    color: var(--color-bg);
  }
</style>
