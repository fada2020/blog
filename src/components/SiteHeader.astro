---
import { withBase } from "../lib/site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a class="site-title" href={withBase("/")}>Field Notes</a>
    <nav class="desktop-nav" aria-label="주요 메뉴">
      <a href={withBase("/")}>글 목록</a>
      <a href={withBase("/categories/")}>카테고리</a>
      <a href={withBase("/tags/")}>태그</a>
      <a href={withBase("/search/")}>검색</a>
    </nav>
    <button
      class="mobile-menu-button"
      type="button"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      메뉴
    </button>
    <ThemeToggle />
  </div>
  <nav
    class="mobile-nav site-shell"
    id="mobile-navigation"
    aria-label="모바일 주요 메뉴"
    hidden
  >
    <a href={withBase("/")}>글 목록</a>
    <a href={withBase("/categories/")}>카테고리</a>
    <a href={withBase("/tags/")}>태그</a>
    <a href={withBase("/search/")}>검색</a>
  </nav>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>(".mobile-menu-button");
  const mobileNavigation =
    document.querySelector<HTMLElement>("#mobile-navigation");

  menuButton?.addEventListener("click", () => {
    if (!mobileNavigation) return;

    const expanded = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!expanded));
    menuButton.setAttribute("aria-label", expanded ? "메뉴 열기" : "메뉴 닫기");
    mobileNavigation.hidden = expanded;
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    height: 72px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 24px;
    align-items: center;
    height: 100%;
  }

  .site-title {
    color: var(--color-text);
    font-size: 22px;
    font-weight: 750;
    text-decoration: none;
  }

  .desktop-nav {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  nav a {
    color: var(--color-muted);
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .mobile-menu-button,
  .mobile-nav {
    display: none;
  }

  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 8px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu-button {
      display: block;
      height: 40px;
      padding-inline: 14px;
      border: 0;
      border-radius: 6px;
      background: var(--color-text);
      color: var(--color-surface);
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .mobile-nav:not([hidden]) {
      position: absolute;
      top: 72px;
      left: 50%;
      display: flex;
      padding-block: 12px;
      transform: translateX(-50%);
      flex-direction: column;
      border: 1px solid var(--color-border);
      border-top: 0;
      border-radius: 0 0 var(--radius) var(--radius);
      background: var(--color-surface);
      box-shadow: 0 12px 24px rgb(23 32 27 / 12%);
    }

    .mobile-nav a {
      padding: 10px 14px;
    }
  }
</style>
